        {
          "id": "267b6b79-0cad-4037-b114-6c89a1054fc0",
          "name": "List objects in a bucket",
          "request": {
            "name": "List objects in a bucket",
            "description": {
              "content": "Returns some or all (up to 1,000) of the objects in a bucket. Use list-type=2 for ListObjectsV2.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":bucket"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "prefix",
                  "value": "<string>",
                  "description": "Limits the response to keys that begin with the specified prefix"
                },
                {
                  "disabled": false,
                  "key": "delimiter",
                  "value": "<string>",
                  "description": "A delimiter is a character you use to group keys"
                },
                {
                  "disabled": false,
                  "key": "marker",
                  "value": "<string>",
                  "description": "Specifies the key to start with when listing objects"
                },
                {
                  "disabled": false,
                  "key": "max-keys",
                  "value": "1000",
                  "description": "Sets the maximum number of keys returned (default 1000)"
                },
                {
                  "disabled": false,
                  "key": "list-type",
                  "value": "<integer>",
                  "description": "Version 2 of list objects request (set to 2)"
                },
                {
                  "disabled": false,
                  "key": "continuation-token",
                  "value": "<string>",
                  "description": "Indicates Amazon S3 that the list is being continued with a token (V2)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "bucket",
                  "description": "(Required) Name of the bucket"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
