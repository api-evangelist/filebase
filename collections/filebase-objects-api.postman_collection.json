          "name": "Upload an object",
          "request": {
            "name": "Upload an object",
            "description": {
              "content": "Adds an object to a bucket. Objects are automatically pinned to IPFS for IPFS-backed buckets and receive 3x geo-redundant replication. The CID is returned in the x-amz-meta-cid response header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":bucket",
                ":key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "bucket",
                  "description": "(Required) Name of the bucket"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "key",
                  "description": "(Required) Object key (file path within the bucket)"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "IPFS CID of the uploaded object (response header)",
                "key": "x-amz-meta-cid",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
