{
  "opencollection": "1.0.0",
  "info": {
    "name": "Filebase IPFS Pinning Service Buckets Node API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Node",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show IPFS node identity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.filebase.io/v1/ipfs/api/v0/id"
          },
          "docs": "Show IPFS node id info."
        }
      ]
    }
  ],
  "bundled": true
}